# LLM Provider — switch between "gemini" (free) and "anthropic" (paid)
LLM_PROVIDER=gemini

# Google Gemini — free tier, get key at aistudio.google.com
GOOGLE_API_KEY=your_google_api_key_here

# Anthropic (Claude) — swap LLM_PROVIDER to "anthropic" to use this instead
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LangSmith — agent tracing and observability (sign up at smith.langchain.com)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=autoboost-agent

# Slack — for approval notifications
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_ID=C0XXXXXXXXX

# Meta Ads (stub — swap for real credentials when Meta Ads MCP is available)
META_ACCESS_TOKEN=your_meta_access_token
META_AD_ACCOUNT_ID=act_XXXXXXXXXX

# App
BOOST_MODE=APPROVAL           # AUTONOMOUS | APPROVAL | NOTIFY_ONLY
SCORE_THRESHOLD=1.5
MONTHLY_BUDGET_CAP=500
DEFAULT_BOOST_BUDGET=50
APPROVAL_TIMEOUT_MINS=60
